async function main(){
 const runId=new Date().toISOString().replace(/[:.]/g,'-'),output='recovery/output/ammo-ai-network-'+runId,dir=mkdtempSync(join(tmpdir(),'cdtank-ammo11-consumption-')),database=join(dir,'accounts.sqlite'),port=3223;let server:ChildProcess|undefined,log='';
