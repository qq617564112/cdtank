 await wait(()=>events[0].some(e=>e.type==='fire'&&e.playerId===ownerId&&e.skillId===2001),25000);evidence.afterDefault=latest();const initialOwner=(evidence.initial as MsgRoomSnapshot).players.find(p=>p.id===ownerId)!;const maxDistance=Math.max(...snapshots[0].map(s=>{const p=s.players.find(p=>p.id===ownerId)!;return Math.hypot(p.x-initialOwner.x,p.z-initialOwner.z);}));evidence.observedMotion={ownerId,maxDistanceAtDefault:maxDistance,scope:'Observed distance only; stationary close-target firing is legal, no navigation acceptance assertion'};
