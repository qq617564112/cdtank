 await wait(()=>latest().phase==='FINISHED',40000);evidence.finished=latest();assert(events[0].some(e=>e.type==='fire'&&e.playerId!==ownerId));assert(events[0].some(e=>e.type==='hit'));for(const c of clients.slice(0,2))assert((await c.callApi('Rematch',{round:1})).isSucc);await wait(()=>latest().phase==='PLAYING'&&latest().match?.round===2);evidence.rematch=latest();const inv2=await clients[0].callApi('Inventory',{});assert(inv2.isSucc);assert.equal(inv2.res.records[0].ownedQuantity,0);assert.equal(inv2.res.records[0].battleQuantity,0);evidence.round2Inventory=inv2.res;await wait(()=>latest().phase==='FINISHED'&&latest().match?.round===2,40000);evidence.round2Finished=latest();
 const sharedEvents=events[0].filter(e=>['ammoConsumed','fire','itemRejected'].includes(e.type)&&e.playerId===ownerId),peerEvents=events[1].filter(e=>['ammoConsumed','fire','itemRejected'].includes(e.type)&&e.playerId===ownerId);assert.deepEqual(sharedEvents,peerEvents);assert.deepEqual(sharedEvents.filter(e=>e.type==='ammoConsumed').map(e=>e.value),[1,0]);assert.equal(sharedEvents.filter(e=>e.type==='fire'&&e.skillId===2011).length,2);const peerId=(evidence.initial as MsgRoomSnapshot).players.find(p=>!p.isCpu&&p.id!==ownerId)!.id;for(const id of [ownerId,peerId]){const own=events[0].filter(e=>e.playerId===id);assert.equal(own.filter(e=>e.type==='fire'&&e.skillId===2011).length,2);assert.deepEqual(own.filter(e=>e.type==='ammoConsumed').map(e=>e.value),[1,0]);assert(own.some(e=>e.type==='fire'&&e.skillId===2001));}assert.equal(events[2].filter(e=>e.roomId===roomId).length,0);
 for(const c of clients.slice(0,2))assert((await c.callApi('Leave',{roomId,round:2})).isSucc);await Promise.all(clients.map(c=>c.disconnect()));await stop();await start();const restored=[];for(let i=0;i<2;i++){assert((await clients[i].connect()).isSucc);assert((await clients[i].callApi('Account',{token:accounts[i].token})).isSucc);const inventory=await clients[i].callApi('Inventory',{});assert(inventory.isSucc);assert.equal(inventory.res.records[0].ownedQuantity,0);assert.equal(inventory.res.hotkeys[0],77);restored.push(inventory.res);}evidence.actualRestart=restored;const reentry=await clients[0].callApi('CreateRoom',{mode:4,mapId:7,name:'恢复账户',tankId:1,roomName:'恢复库存验收'});assert(reentry.isSucc);assert((await clients[0].callApi('Ready',{round:1,isReady:true})).isSucc);await wait(()=>latest().roomId===reentry.res.room.id&&latest().phase==='PLAYING');const rebound=await clients[0].callApi('Inventory',{});assert(rebound.isSucc);assert.equal(rebound.res.records[0].battleQuantity,0);evidence.restartReentryInventory=rebound.res;assert((await clients[0].callApi('Leave',{roomId:reentry.res.room.id,round:1})).isSucc);evidence.status='PASS';console.log(JSON.stringify({status:'PASS',output,ownerFire:countFire(),consumed:[1,0],restartOwned:restored.map(i=>i.records[0].ownedQuantity)}));
