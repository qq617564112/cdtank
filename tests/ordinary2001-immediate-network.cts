 const created=await clients[0].callApi('CreateRoom',{mode:4,mapId:7,name:'普通即时',tankId:1,roomName:'普通即时'});assert(created.isSucc);const roomId=created.res.room.id,ownerId=created.res.playerId;const joined=await clients[1].callApi('Join',{clientId:'ordinary-peer',name:'即时观察',tankId:1,roomId});assert(joined.isSucc);assert((await clients[0].callApi('Cpu',{round:1,operation:'ADD',tankId:1})).isSucc);assert((await clients[1].callApi('Ready',{round:1,isReady:true})).isSucc);assert((await clients[0].callApi('Ready',{round:1,isReady:true})).isSucc);await wait(()=>latest()?.phase==='PLAYING');evidence.initial=latest();assert.equal(latest().players.find(p=>p.id===ownerId)!.maxHp,200);
 // One ordinary initial shot follows the unmodified spawn aim; no target/position injection.
 assert((await clients[0].sendMsg('PlayerInput',{sequence:1,move:0,turn:0,aim:0,fire:true,useItem:0,clientTime:Date.now()})).isSucc);await wait(()=>events[0].some(e=>e.type==='fire'&&e.playerId===ownerId));assert((await clients[0].sendMsg('PlayerInput',{sequence:2,move:0,turn:0,aim:0,fire:false,useItem:0,clientTime:Date.now()})).isSucc);assert((await clients[0].callApi('Autopilot',{round:1,enabled:true})).isSucc);assert((await clients[1].callApi('Autopilot',{round:1,enabled:true})).isSucc);
 await wait(()=>events[0].some(e=>e.type==='hit'&&e.shotPlayerResult?.itemId===2001)&&events[0].some(e=>e.type==='destroy')&&events[0].some(e=>e.type==='respawn'),60000);
 await wait(()=>events[1].length>=events[0].length-5);const relevant=(i:number)=>timed.filter(t=>t.page===i&&['fire','hit','terrainHit','objectHit','objectDestroyed','destroy','respawn'].includes(t.event.type));const firstHit=relevant(0).find(t=>t.event.type==='hit'&&t.event.shotPlayerResult?.itemId===2001)!;const hitIndex=events[0].indexOf(firstHit.event),fire=events[0].slice(0,hitIndex).reverse().find(e=>e.type==='fire'&&e.playerId===firstHit.event.playerId&&e.targetId===firstHit.event.targetId)!;assert(fire&&fire.skillId===2001&&!fire.shotDisplay);const fireTimed=timed.find(t=>t.page===0&&t.event===fire)!;assert.equal(fireTimed.tick,firstHit.tick);const peerHit=relevant(1).find(t=>JSON.stringify(t.event)===JSON.stringify(firstHit.event))!;assert(peerHit);const peerFire=relevant(1).find(t=>JSON.stringify(t.event)===JSON.stringify(fire))!;assert(peerFire);assert.equal(peerFire.tick,peerHit.tick);assert(relevant(1).indexOf(peerFire)<relevant(1).indexOf(peerHit));evidence.immediate={fire:fireTimed,hit:firstHit,peerFire,peerHit};
 const left=relevant(0).map(t=>t.event),right=relevant(1).map(t=>t.event),sharedCount=Math.min(left.length,right.length);assert.deepEqual(left.slice(0,sharedCount),right.slice(0,sharedCount));evidence.orderedNotices={sharedCount,events:left.slice(0,sharedCount)};assert(snapshots.every(s=>s.every(w=>w.bullets.length===0)));evidence.noBullets=true;
 const display=relevant(0).filter(t=>t.event.type==='fire'&&t.event.shotDisplay?.itemId===2001);assert(display.length>0);for(const shot of display){assert(!shot.event.shotPlayerResult);assert(!relevant(0).some(t=>t.tick===shot.tick&&t.event.type==='hit'&&t.event.playerId===shot.event.playerId&&t.event.targetId===shot.event.targetId&&t.event.shotPlayerResult));}evidence.sceneFreeDisplays=display;
 const matching=snapshots[0].find(a=>a.tick>firstHit.tick&&a.players.some(p=>p.id===firstHit.event.targetId&&p.hp<p.maxHp)&&snapshots[1].some(b=>a.tick===b.tick&&JSON.stringify(a.players)===JSON.stringify(b.players)));assert(matching);evidence.sharedSnapshot={owner:matching,peer:snapshots[1].find(b=>b.tick===matching.tick)};evidence.life={destroy:events[0].find(e=>e.type==='destroy'),respawn:events[0].find(e=>e.type==='respawn')};for(const c of clients)assert((await c.callApi('Leave',{roomId,round:1})).isSucc);evidence.leave=true;evidence.status='PASS';console.log(JSON.stringify({status:'PASS',output,immediateTick:firstHit.tick,sharedCount}));
 }catch(error){evidence.status='FAIL';evidence.error=String(error);throw error;}finally{evidence.snapshots=snapshots;evidence.events=events;evidence.timed=timed;await Promise.allSettled(clients.map(c=>c.disconnect()));await stop();writeFileSync(output+'.json',JSON.stringify(evidence,null,2)+'\n');writeFileSync(output+'.log',log);rmSync(dir,{recursive:true,force:true});}
}main().catch(e=>{console.error(e);process.exitCode=1;});
